# Base URL of the LegalKart consumer API. When unset, the site runs on bundled
# preview data and shows a "Preview data" banner on every page.
NEXT_PUBLIC_API_BASE_URL=

# Canonical origin used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.legalkart.com

# Existing auth / wallet entry points (consult flow hands off here).
NEXT_PUBLIC_LOGIN_URL=/login
NEXT_PUBLIC_WALLET_RECHARGE_URL=/wallet/recharge

# Store listings. App-store buttons are hidden until these are set.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=

# Hostname for lawyer photos / product images (next/image allow-list).
NEXT_PUBLIC_IMAGE_HOST=
